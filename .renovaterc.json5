{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>krezh/renovate-config"],
  nix: {
    enabled: true,
  },
  customManagers: [
    {
      customType: "regex",
      description: "Track CachyOS Linux releases",
      managerFilePatterns: ["(^|/)VERSION$"],
      matchStrings: [
        "^(?<currentValue>cachyos-[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[0-9]+)?)\\s*$",
      ],
      datasourceTemplate: "github-releases",
      depNameTemplate: "CachyOS/linux",
      packageNameTemplate: "CachyOS/linux",
      versioningTemplate: "regex:^cachyos-(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?(?:-(?<build>\\d+))?$",
    },
  ],
  packageRules: [
    {
      description: "CachyOS Kernel release updates",
      matchPackageNames: ["CachyOS/linux"],
      semanticCommitType: "chore",
      semanticCommitScope: "kernel",
      commitMessageTopic: "CachyOS kernel",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
      postUpgradeTasks: {
        commands: [
          'nix --extra-experimental-features "nix-command flakes" run .#update-sources',
        ],
        fileFilters: [
          "VERSION",
          "kernel-cachyos/sources.nix",
        ],
        executionMode: "update",
      },
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Keep the tested kernel toolchain pinned",
      matchManagers: ["nix"],
      matchDepNames: ["nixpkgs"],
      enabled: false,
    },
    {
      description: "Nix flake lockfile maintenance",
      matchManagers: ["nix"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
  ],
}
